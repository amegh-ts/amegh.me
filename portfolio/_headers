/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# Summary for AI tools (llmstxt.org). Readable by any crawler, but kept out of
# Google results so it never competes with the HTML pages.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex

# ---- Caching. HTML keeps Cloudflare's default (revalidate every time) so new
# releases show at once; static files are cached so repeat visits load nothing.

# Font: one year, never revalidated. If the font file changes, give it a new name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and icons: a week, then refreshed in the background.
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/site.webmanifest
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Shared CSS and JS for /about and /work/*: an hour, then refreshed in the background.
/page.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/hover.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

# Preload hints on HTML pages (Cloudflare can send them as 103 Early Hints).
/
  Link: </fonts/bricolage-grotesque-latin.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin
/about
  Link: </fonts/bricolage-grotesque-latin.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin, </page.css>; rel=preload; as=style
/work
  Link: </fonts/bricolage-grotesque-latin.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin, </page.css>; rel=preload; as=style
/work/*
  Link: </fonts/bricolage-grotesque-latin.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin, </page.css>; rel=preload; as=style
